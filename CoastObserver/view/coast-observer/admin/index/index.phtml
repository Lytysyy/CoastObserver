<script>
  // URLs générées par Omeka (gèrent le /omk_THyp_25-26_clone/)
  const TIDE_URL = '<?= $this->url('admin/coast-observer/tide-height'); ?>';
  const SUGGEST_TITLE_URL = '<?= $this->url('admin/coast-observer/suggest-title'); ?>';

  const $ = sel => document.querySelector(sel);
  const esc = s => (s ?? "").toString().replace(/[&<>"']/g, c => (
    {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]
  ));

  // CLÉS API FIXES
  const API_KEY_ID = 'ab2dPIwoP9u6JJQTEy8aieh0GPaTcj6E';
  const API_KEY_SECRET = 'zd3HJsk8bvzP79eR89VW7af4mdLelGdU';

  function buildApiUrl(path) {
    const baseInput = $('#apiBase');
    const base = baseInput ? baseInput.value.trim().replace(/\/+$/, '') : '';
    if (!base) throw new Error("URL API manquante.");
    const url = new URL(base + path);
    if (API_KEY_ID && API_KEY_SECRET) {
      url.searchParams.set('key_identity', API_KEY_ID);
      url.searchParams.set('key_credential', API_KEY_SECRET);
    }
    return url.toString();
  }

  async function apiGet(path) {
    const url = buildApiUrl(path);
    const res = await fetch(url, { method: 'GET' });
    if (!res.ok) throw new Error(`GET ${url} → ${res.status} ${res.statusText}`);
    return res.json();
  }

  async function apiPostForm(path, formData) {
    const url = buildApiUrl(path);
    const res = await fetch(url, {
      method: 'POST',
      body: formData
    });
    const text = await res.text();
    let data;
    try { data = JSON.parse(text); } catch { data = text; }
    if (!res.ok) {
      throw new Error(`POST ${url} → ${res.status} ${res.statusText}\n${text}`);
    }
    return data;
  }

  function initCoastObserver() {
    // LISTE DES ITEMS
    const btnFetch = $('#btnFetch');
    if (btnFetch) {
      btnFetch.addEventListener('click', async () => {
        const status = $('#readStatus');
        const tableDiv = $('#readTable');
        const rawRead = $('#rawRead');

        if (!status || !tableDiv || !rawRead) return;

        status.textContent = 'Chargement…';
        status.className = 'status';
        tableDiv.innerHTML = '';
        rawRead.textContent = '';
        btnFetch.disabled = true;

        try {
          const params = new URLSearchParams();
          params.set('per_page', '50');

          const data = await apiGet(`/items?${params.toString()}`);

          const rows = (Array.isArray(data) ? data : []).map(it => {
            const id = esc(it['o:id']);
            const title = (it['o:title'])
              || (it['dcterms:title'] && it['dcterms:title'][0] && it['dcterms:title'][0]['@value'])
              || '(sans titre)';
            const updated = esc(it['o:modified'] || it['o:created'] || '');
            return `
              <tr>
                <td>#${id}</td>
                <td>${esc(title)}</td>
                <td>${updated.replace('T',' ').replace('Z','')}</td>
              </tr>`;
          }).join('');

          tableDiv.innerHTML = rows
            ? `<table><thead><tr><th>ID</th><th>Titre</th><th>Modifié</th></tr></thead><tbody>${rows}</tbody></table>`
            : '<div class="hint" style="margin-top:6px;">Aucun résultat.</div>';

          rawRead.textContent = JSON.stringify(data, null, 2);
          status.textContent = `OK – ${Array.isArray(data) ? data.length : 0} item(s).`;
          status.className = 'status ok';
        } catch (err) {
          status.textContent = 'Erreur : ' + err.message;
          status.className = 'status error';
        } finally {
          btnFetch.disabled = false;
        }
      });
    }

    const btnClearRead = $('#btnClearRead');
    if (btnClearRead) {
      btnClearRead.addEventListener('click', () => {
        const status = $('#readStatus');
        const tableDiv = $('#readTable');
        const rawRead = $('#rawRead');

        if (status) {
          status.textContent = '';
          status.className = 'status';
        }
        if (tableDiv) tableDiv.innerHTML = '';
        if (rawRead) rawRead.textContent = '';
      });
    }

    // APERÇU IMAGE
    const mediaFileInput = $('#mediaFile');
    if (mediaFileInput) {
      mediaFileInput.addEventListener('change', () => {
        const imgPreview = $('#imagePreview');
        if (!imgPreview) return;

        imgPreview.style.display = 'none';
        imgPreview.removeAttribute('src');

        const file = mediaFileInput.files[0];
        if (file && file.type.startsWith('image/')) {
          const url = URL.createObjectURL(file);
          imgPreview.src = url;
          imgPreview.style.display = 'block';
        }
      });
    }

    // 💡 BOUTON IA : Générer un titre
    const btnSuggestTitle = $('#btnSuggestTitle');
    if (btnSuggestTitle) {
      btnSuggestTitle.addEventListener('click', async () => {
        const iaStatus = $('#iaStatus');
        const mediaTitleInput = $('#mediaTitle');

        if (!iaStatus || !mediaTitleInput) return;

        iaStatus.textContent = 'IA : calcul du titre…';
        btnSuggestTitle.disabled = true;

        try {
          // 1) Date/heure UTC actuelle
          const nowUtcIso = new Date().toISOString();

          // 2) On récupère d’abord la hauteur d’eau depuis le module (tide-height)
          let hauteurEau = 0;
          try {
            const tideRes = await fetch(
              TIDE_URL + '?datetime=' + encodeURIComponent(nowUtcIso) + '&sector=cote_dopale'
            );
            if (tideRes.ok) {
              const tideJson = await tideRes.json();
              if (tideJson.success && tideJson.hauteur_eau !== undefined && tideJson.hauteur_eau !== null) {
                const parsed = parseFloat(tideJson.hauteur_eau);
                if (!Number.isNaN(parsed)) {
                  hauteurEau = parsed;
                }
              }
            }
          } catch (e) {
            console.warn('Erreur marée pour IA :', e);
          }

          // 3) Appel au endpoint IA (suggest-title)
          const suggestUrl = new URL(SUGGEST_TITLE_URL, window.location.origin);
          suggestUrl.searchParams.set('height', hauteurEau.toString());
          suggestUrl.searchParams.set('datetime', nowUtcIso);
          suggestUrl.searchParams.set('sector', 'Cote dOpale');

          const iaRes = await fetch(suggestUrl.toString());
          if (!iaRes.ok) {
            throw new Error('HTTP ' + iaRes.status + ' ' + iaRes.statusText);
          }
          const iaJson = await iaRes.json();
          console.log('IA suggest-title →', iaJson);

          if (!iaJson.success) {
            throw new Error(iaJson.error || 'Erreur IA inconnue');
          }

          const title = (iaJson.title || '').trim();
          if (!title) {
            throw new Error('Titre vide renvoyé par IA');
          }

          mediaTitleInput.value = title;
          iaStatus.textContent = 'Titre IA appliqué ✔️';

        } catch (err) {
          iaStatus.textContent = 'IA : ' + err.message;
        } finally {
          btnSuggestTitle.disabled = false;
        }
      });
    }

    // ENVOI DU MEDIA IMAGE AVEC HAUTEUR D'EAU
    const btnAddMedia = $('#btnAddMedia');
    if (btnAddMedia) {
      btnAddMedia.addEventListener('click', async () => {
        const status = $('#mediaStatus');
        const rawMedia = $('#rawMedia');
        const itemIdInput = $('#mediaItemId');
        const mediaTitleInput = $('#mediaTitle');
        const fileInput = $('#mediaFile');

        if (!status || !rawMedia || !itemIdInput || !fileInput) return;

        status.textContent = 'Envoi…';
        status.className = 'status';
        rawMedia.textContent = '';
        btnAddMedia.disabled = true;

        try {
          const itemId = itemIdInput.value.trim();
          const mediaTitle = mediaTitleInput ? mediaTitleInput.value.trim() : '';
          let file = fileInput.files[0];

          if (!itemId) {
            throw new Error("ID d’item obligatoire.");
          }

          if (!file) {
            throw new Error('Choisis un fichier image.');
          }

          if (!file.type.startsWith('image/')) {
            throw new Error('Le fichier doit être une image (PNG, JPG…).');
          }

          // 1) Date/heure actuelle en UTC (ISO 8601)
          const nowUtcIso = new Date().toISOString();

          // 2) Hauteur d'eau via le module (tide-height)
          let hauteurEau = 0;
          try {
            const tideRes = await fetch(
              TIDE_URL + '?datetime=' + encodeURIComponent(nowUtcIso) + '&sector=cote_dopale'
            );
            if (tideRes.ok) {
              const tideJson = await tideRes.json();
              console.log('Réponse marée :', tideJson);

              if (tideJson.success && tideJson.hauteur_eau !== undefined && tideJson.hauteur_eau !== null) {
                const parsed = parseFloat(tideJson.hauteur_eau);
                if (!Number.isNaN(parsed)) {
                  hauteurEau = parsed;
                } else {
                  console.warn('Hauteur marée non numérique, on garde 0 →', tideJson.hauteur_eau);
                }
              } else {
                console.warn('Marée :', tideJson.error || 'pas de donnée, hauteur=0');
              }
            } else {
              console.warn('Erreur HTTP marée :', tideRes.status, tideRes.statusText);
            }
          } catch (e) {
            console.warn('Erreur appel marée :', e, ' → hauteur=0');
          }

          // 3) Métadonnées du média — schéma Omeka (ressource + Dublin Core)
          const mediaData = {
            "o:item": { "o:id": Number(itemId) },
            "o:ingester": "upload",
            "file_index": 0,
            "o:is_public": true,

            // Titre natif du média
            "o:title": mediaTitle || "Image sans titre",

            // Titre Dublin Core
            "dcterms:title": mediaTitle
              ? [{
                  "type": "literal",
                  "property_id": "auto",
                  "@value": mediaTitle
                }]
              : [],

            // Date UTC
            "dcterms:date": [
              {
                "type": "literal",
                "property_id": "auto",
                "@value": nowUtcIso
              }
            ],

            // Secteur
            "dcterms:coverage": [
              {
                "type": "literal",
                "property_id": "auto",
                "@value": "Côte d’Opale"
              }
            ],

            // Hauteur d'eau (0 m si aucune donnée)
            "dcterms:extent": [
              {
                "type": "literal",
                "property_id": "auto",
                "@value": `${hauteurEau} m`
              }
            ]
          };

          const fd = new FormData();
          fd.append('data', JSON.stringify(mediaData));
          fd.append('file[0]', file);

          rawMedia.textContent =
            'Payload →\n' + JSON.stringify(mediaData, null, 2) +
            '\n\nFichier → ' + file.name;

          const createdMedia = await apiPostForm('/media', fd);

          status.textContent =
            'Image ajoutée – média ID ' + (createdMedia && createdMedia['o:id']) +
            ' (item ' + itemId + ')';
          status.className = 'status ok';

          rawMedia.textContent +=
            '\n\nRéponse ←\n' + JSON.stringify(createdMedia, null, 2);

        } catch (err) {
          status.textContent = 'Erreur : ' + err.message;
          status.className = 'status error';
        } finally {
          btnAddMedia.disabled = false;
        }
      });
    }

    const btnClearMedia = $('#btnClearMedia');
    if (btnClearMedia) {
      btnClearMedia.addEventListener('click', () => {
        const itemIdInput = $('#mediaItemId');
        const mediaTitleInput = $('#mediaTitle');
        const fileInput = $('#mediaFile');
        const status = $('#mediaStatus');
        const rawMedia = $('#rawMedia');
        const imgPreview = $('#imagePreview');
        const iaStatus = $('#iaStatus');

        if (itemIdInput) itemIdInput.value = '';
        if (mediaTitleInput) mediaTitleInput.value = '';
        if (fileInput) fileInput.value = '';
        if (status) {
          status.textContent = '';
          status.className = 'status';
        }
        if (rawMedia) rawMedia.textContent = '';
        if (imgPreview) {
          imgPreview.removeAttribute('src');
          imgPreview.style.display = 'none';
        }
        if (iaStatus) iaStatus.textContent = '';
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initCoastObserver);
</script>
