@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

@prefix coast: <https://lytysyy.github.io/CoastObserver/vocab#> .
@base <https://lytysyy.github.io/CoastObserver/vocab> .

<https://lytysyy.github.io/CoastObserver/vocab>
  a owl:Ontology ;
  dct:title "Vocabulaire CoastObserver (simple)"@fr ;
  dct:description "Vocabulaire minimal pour Omeka S avec une seule classe Observation et un champ secteur (texte)."@fr ;
  owl:versionInfo "1.0.0"@fr .

###########
# CLASSE  #
###########

coast:Observation a owl:Class ;
  rdfs:label "Observation"@fr ;
  rdfs:comment "Observation minimale (titre, secteur, date, lieu, notes)."@fr .

################
# PROPRIÉTÉS  #
################

coast:secteur a owl:DatatypeProperty ;
  rdfs:label "Secteur"@fr ;
  rdfs:comment "Nom du secteur étudié (valeur texte)."@fr ;
  rdfs:domain coast:Observation ;
  rdfs:range xsd:string .

coast:dateObservation a owl:DatatypeProperty ;
  rdfs:label "Date de l’observation"@fr ;
  rdfs:comment "Date au format YYYY-MM-DD."@fr ;
  rdfs:domain coast:Observation ;
  rdfs:range xsd:date .

coast:lieu a owl:DatatypeProperty ;
  rdfs:label "Lieu"@fr ;
  rdfs:comment "Toponyme ou description courte."@fr ;
  rdfs:domain coast:Observation ;
  rdfs:range xsd:string .

coast:notes a owl:DatatypeProperty ;
  rdfs:label "Notes"@fr ;
  rdfs:comment "Notes libres."@fr ;
  rdfs:domain coast:Observation ;
  rdfs:range xsd:string .
